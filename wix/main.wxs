<?xml version='1.0' encoding='windows-1252'?>

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='watch-rs'
        UpgradeCode='33BB22C0-7119-4942-BB60-0C631E363E20'
        Manufacturer='DrEsteban'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='A Rust implementation of Linux&#39;s `watch` with extended features'
            Manufacturer='DrEsteban'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='watch-rs Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='watch-rs'>
                    <Component Id='License' Guid='*'>
                        <File
                            Id='LicenseFile'
                            DiskId='1'
                            Source='LICENSE'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component
                            Id='Path'
                            Guid='175EA972-0075-41C3-95C2-2EB1ABBA4218'
                            KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>

                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='watchr.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\watchr.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the executable to the system PATH.'
                Level='1'
                Absent='disallow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty
            Id='ARPINSTALLLOCATION'
            Value='[APPLICATIONFOLDER]'
            After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/DrEsteban/watch-rust'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish
                Dialog='WelcomeDlg'
                Control='Next'
                Event='NewDialog'
                Value='CustomizeDlg'
                Order='99'>1</Publish>
            <Publish
                Dialog='CustomizeDlg'
                Control='Back'
                Event='NewDialog'
                Value='WelcomeDlg'
                Order='99'>1</Publish>
        </UI>
    </Product>
</Wix>
